# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:5173/my-data
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra Admin Center (Azure Portal) -> App registrations -> Web / SPA Redirect URI: http://localhost:5173/my-data
VITE_MICROSOFT_CLIENT_ID=

# Server-side Google Gemini API key (store in .env.local; never prefix with VITE_)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional Gemini model override (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

